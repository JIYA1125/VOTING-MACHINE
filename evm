`timescale 1ns / 1ps

module evm(
    input clk,
    input reset,
    input vote_enable,

    input c1,
    input c2,
    input c3,
    input c4,

    input result_btn,

    output reg [7:0] vote1,
    output reg [7:0] vote2,
    output reg [7:0] vote3,
    output reg [7:0] vote4,

    output reg [3:0] winner_led
);

reg c1_d, c2_d, c3_d, c4_d;

always @(posedge clk or posedge reset)
begin
    if(reset)
    begin
        vote1 <= 0;
        vote2 <= 0;
        vote3 <= 0;
        vote4 <= 0;

        c1_d <= 0;
        c2_d <= 0;
        c3_d <= 0;
        c4_d <= 0;

        winner_led <= 4'b0000;
    end
    else
    begin

        // Store previous button values
        c1_d <= c1;
        c2_d <= c2;
        c3_d <= c3;
        c4_d <= c4;

        //---------------- Voting ----------------

        if(vote_enable)
        begin

            if(c1 && !c1_d)
                vote1 <= vote1 + 1;

            else if(c2 && !c2_d)
                vote2 <= vote2 + 1;

            else if(c3 && !c3_d)
                vote3 <= vote3 + 1;

            else if(c4 && !c4_d)
                vote4 <= vote4 + 1;
        end
        if(result_btn)
        begin

            if(vote1>=vote2 && vote1>=vote3 && vote1>=vote4)
                winner_led <= 4'b0001;

            else if(vote2>=vote1 && vote2>=vote3 && vote2>=vote4)
                winner_led <= 4'b0010;

            else if(vote3>=vote1 && vote3>=vote2 && vote3>=vote4)
                winner_led <= 4'b0100;

            else
                winner_led <= 4'b1000;

        end
        else
            winner_led <= 4'b0000;

    end

end

endmodule
